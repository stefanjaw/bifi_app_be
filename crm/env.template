# ========================================
# .env.example – CRM Backend (TypeScript)
# Copy this file to .env and fill in real values
# ========================================

# ───────────────────────────────
# Server & Environment
# ───────────────────────────────
PORT=5000
NODE_ENV=development        # development | production | test

# ───────────────────────────────
# MongoDB Connection
# ───────────────────────────────
# Local
MONGO_URI=mongodb://127.0.0.1:27017/crmdb

# Or MongoDB Atlas (uncomment and replace)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crmdb?retryWrites=true&w=majority

# ───────────────────────────────
# JWT Authentication
# ───────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_string_2025!
JWT_EXPIRE=7d               # 1h | 24h | 7d | 30d | etc.

# ───────────────────────────────
# Bcrypt (optional – can leave default)
# ───────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ───────────────────────────────
# CORS (only needed in development if frontend is on another port)
# ───────────────────────────────
CORS_ORIGIN=http://localhost:3000
# Multiple origins example (comma-separated):
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://myapp.com

# ───────────────────────────────
# Email / SMTP (optional – for password reset, notifications, etc.)
# ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-oauth-token
EMAIL_FROM=noreply@crm-company.com

# ───────────────────────────────
# File Uploads (if you add document/attachment feature later)
# ───────────────────────────────
UPLOAD_MAX_SIZE=10485760    # 10 MB in bytes
UPLOAD_DESTINATION=./uploads

# ───────────────────────────────
# External APIs (optional)
# ───────────────────────────────
CLEARBIT_API_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXX
HUBSPOT_API_KEY=hxxxxxxxxxxxxxxxxxxxxxx

# ───────────────────────────────
# Logging (optional)
# ───────────────────────────────
LOG_LEVEL=info              # silly | debug | info | warn | error