SERVER_PORT=8080

# CORS — comma-separated list of allowed frontend origins. Production MUST set this.
# When empty, falls back to localhost for dev.
CORS_ORIGINS=""

# MONGO DB
MONGO_DB_URL="mongodb://localhost:27017/bifi_app_db"

# FIREBASE — paste the full service-account JSON blob here
FIREBASE_SERVICE_ACCOUNT='
{
  "type": "service_account",
  "project_id": "<your-project-id>",
  "private_key_id": "<key-id>",
  "private_key": "-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----\n",
  "client_email": "<firebase-adminsdk@<your-project-id>.iam.gserviceaccount.com>",
  "client_id": "<client-id>",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/<client-email>",
  "universe_domain": "googleapis.com"
}
'

# RBAC — keep "true" in all environments. Disabling removes all authorization.
RBAC_ENABLE="true"

# AI
GOOGLE_GENAI_API_KEY=""

# FTP
FTP_HOST=""
FTP_BASE_PATH=""
FTP_USER=""
FTP_PASSWORD=""

# CR E-Invoice
CR_EINVOICE_SERVER_URL=""

# Email marketing — REQUIRED. Unsubscribe tokens are signed with this secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_TOKEN_SECRET=""

# Tenant DB allowlist — comma-separated list of valid DB names for the `dbname` header.
# If empty, the header is rejected (fail-closed). Example: "bifi_app_db,tenant_a,tenant_b"
TENANT_DB_NAMES=""

# Auto-provisioning allowlist — comma-separated email domains permitted to self-provision
# an application account on first login. If empty, unknown uids are rejected (fail-closed).
# Example: "yourcompany.com,partner.com"
AUTO_PROVISION_EMAIL_DOMAINS=""

# Email marketing webhook secret — REQUIRED in production for ESP webhook signature verification.
# Each provider (Mailgun, SendGrid, Resend) uses this to verify webhook callbacks.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_WEBHOOK_SECRET=""
